rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Reusable Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidRollId(id) {
      return id is string && id.size() == 3 && id.matches('^(3[0-9]{2}|400)$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'v9842957434@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // 3. Entity Validation Blueprints
    function isValidRollEntry(data, rollId) {
      return data.keys().hasAll(['rollNumber', 'name', 'entries', 'status', 'notes', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly(['rollNumber', 'name', 'entries', 'status', 'notes', 'updatedBy', 'updatedAt'])
        && data.rollNumber is int
        && data.rollNumber >= 301
        && data.rollNumber <= 400
        && string(data.rollNumber) == rollId
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 80
        && data.entries is int
        && data.entries >= 0
        && data.entries <= 1000000
        && data.status is string
        && data.status in ['paid', 'unpaid', 'pending']
        && data.notes is string
        && data.notes.size() <= 200
        && data.updatedBy is string
        && data.updatedBy == request.auth.uid
        && data.updatedBy.size() >= 1
        && data.updatedBy.size() <= 128
        && data.updatedAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidPublicRollSlip(data, rollId) {
      return data.keys().hasAll(['rollNumber', 'name', 'entries', 'updatedAt'])
        && data.keys().hasOnly(['rollNumber', 'name', 'entries', 'updatedAt'])
        && data.rollNumber is int
        && data.rollNumber >= 301
        && data.rollNumber <= 400
        && string(data.rollNumber) == rollId
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 80
        && data.entries is int
        && data.entries >= 0
        && data.entries <= 1000000
        && data.updatedAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidLedgerSettings(data) {
      return data.keys().hasAll(['title', 'unitRate', 'currencySymbol', 'totalRolls', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly(['title', 'unitRate', 'currencySymbol', 'totalRolls', 'updatedBy', 'updatedAt'])
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 60
        && (data.unitRate is int || data.unitRate is float)
        && data.unitRate >= 0
        && data.unitRate <= 1000000
        && data.currencySymbol is string
        && data.currencySymbol.size() >= 1
        && data.currencySymbol.size() <= 5
        && data.totalRolls is int
        && data.totalRolls == 100
        && data.updatedBy is string
        && data.updatedBy == request.auth.uid
        && data.updatedBy.size() >= 1
        && data.updatedBy.size() <= 128
        && data.updatedAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidAdminUser(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'addedBy', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'addedBy', 'createdAt'])
        && data.uid is string
        && data.uid == userId
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 120
        && data.addedBy is string
        && data.addedBy == request.auth.uid
        && data.addedBy.size() >= 1
        && data.addedBy.size() <= 128
        && data.createdAt is timestamp
        && data.createdAt == request.time;
    }

    // 4. Collection Rules
    match /rolls/{rollId} {
      allow get: if isAdmin() && isValidRollId(rollId);
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidRollId(rollId) && isValidRollEntry(incoming(), rollId);
      allow update: if isAdmin()
        && isValidRollId(rollId)
        && isValidRollEntry(incoming(), rollId)
        && incoming().rollNumber == existing().rollNumber
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'entries', 'status', 'notes', 'updatedBy', 'updatedAt']);
      allow delete: if isAdmin() && isValidRollId(rollId);
    }

    match /publicRolls/{rollId} {
      allow get: if isValidRollId(rollId);
      allow list: if false;
      allow create: if isAdmin() && isValidRollId(rollId) && isValidPublicRollSlip(incoming(), rollId);
      allow update: if isAdmin()
        && isValidRollId(rollId)
        && isValidPublicRollSlip(incoming(), rollId)
        && incoming().rollNumber == existing().rollNumber
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'entries', 'updatedAt']);
      allow delete: if isAdmin() && isValidRollId(rollId);
    }

    match /settings/{settingId} {
      allow get: if isValidId(settingId) && settingId == 'ledger';
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(settingId) && settingId == 'ledger' && isValidLedgerSettings(incoming());
      allow update: if isAdmin()
        && isValidId(settingId)
        && settingId == 'ledger'
        && isValidLedgerSettings(incoming())
        && incoming().totalRolls == existing().totalRolls
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'unitRate', 'currencySymbol', 'updatedBy', 'updatedAt']);
      allow delete: if false;
    }

    match /admins/{userId} {
      allow get: if isAdmin() || (isVerifiedUser() && isValidId(userId) && userId == request.auth.uid);
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(userId) && isValidAdminUser(incoming(), userId);
      allow update: if false;
      allow delete: if isAdmin() && isValidId(userId);
    }
  }
}
